<style>
    .gallery {
   display: flex;
   flex-wrap: wrap;
   gap: 15px;
    }
    .img-section img {
      display: block;
    width: 100%;
    padding: 0;
    aspect-ratio: 16 /9;
    object-fit: cover;
    max-height: 200px;
    object-position: center;
    margin-bottom: 0.5rem;
    transition: 200ms transform ease-in-out;
    }
    .img-section img:hover {
        cursor: pointer;
      transform: scale(1.05);
    }
    .img-section form{
    border-radius: 5px;
    background: var(--nav-bg-color);
    padding:  .2rem;
}
/* confirmation modal styles */
.confirm-modal-wrapper{
  position: fixed;
  inset: 0;
  display: none;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,.5);
  z-index: 9999;
}
.confirm-modal-wrapper.show{
  display: flex;
}
.confirm-modal{
  background: #fff;
  padding: 1.2rem;
  border-radius: 6px;
  width: 90%;
  max-width: 420px;
  text-align: center;
}
.confirm-modal button{ margin: .5rem }
</style>
<div class="main-wrapper">
{{> adminNavBar}}
{{> message}}
<div class="gallery">
{{#each images}}
<div class="img-section">
 <img  src="{{this.publicUrl}}" alt="Image" />
    <form action="/admin/manage-media/delete" method="post">
      <input type="hidden" name="imageName" value="{{this.name}}" />
      <button class="btn-secondary" type="submit">Delete</button>
    </form>
</div>
{{/each}}
</div>
<div class="image-modal-wrapper">
<div class="image-modal-contain">
    <span class="close">&times;</span>
    <img class="modal-img" src= "" alt="media">
  </div>
</div>

<!-- Delete confirmation modal -->
<div class="confirm-modal-wrapper" id="confirm-delete-modal">
  <div class="confirm-modal">
    <h3>Confirm delete</h3>
    <p id="confirm-delete-message">Are you sure you want to delete this image?</p>
    <!-- Add this inside confirm modal -->

    <div>
      <button id="confirm-delete-btn" class="btn btn-danger">Delete</button>
      <button id="cancel-delete-btn" class="btn-secondary">Cancel</button>
    </div>
  </div>
</div>
<script>
const galleryImages = document.querySelectorAll('.gallery img');
const imageModal = document.querySelector(".image-modal-wrapper");
const modalImg = document.querySelector(".modal-img");
const imageCancleBtn = document.querySelector(".close");
const showImageModal = ()=>{
  imageModal.classList.toggle("show-modal")
}
galleryImages.forEach(img=>{
img.addEventListener("click", ()=>{
    modalImg.src = img.src;
    showImageModal();
});
});
imageCancleBtn.addEventListener("click",showImageModal);
window.addEventListener("click", (e)=>{
  if(e.target.matches(".image-modal-contain")){
    return showImageModal()
  }else
  return
})

// Delete confirmation modal logic
const confirmModalWrapper = document.getElementById('confirm-delete-modal');
const confirmDeleteBtn = document.getElementById('confirm-delete-btn');
const cancelDeleteBtn = document.getElementById('cancel-delete-btn');
const confirmMessage = document.getElementById('confirm-delete-message');
let activeDeleteForm = null;

// Attach submit handler to delete forms
const deleteForms = document.querySelectorAll('.img-section form');
deleteForms.forEach((form) => {
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    activeDeleteForm = form;
    const imageName = form.querySelector('input[name="imageName"]').value;
    confirmMessage.textContent = `Are you sure you want to delete?`;
    confirmModalWrapper.classList.add('show');
  });
});

cancelDeleteBtn.addEventListener('click', (e) => {
  e.preventDefault();
  activeDeleteForm = null;
  confirmModalWrapper.classList.remove('show');
});

confirmDeleteBtn.addEventListener('click', (e) => {
  e.preventDefault();
  if (!activeDeleteForm) return;
  // Submit the form programmatically (this preserves POST encoding)
  activeDeleteForm.submit();
});
</script>
</div>
